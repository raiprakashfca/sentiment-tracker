# Ignore credentials and logs
gcreds.json
*.csv

# Ignore compiled files and system clutter
__pycache__/
*.pyc
.env
.DS_Store

# Keep skill assets (overrides the *.csv rule above)
!.claude/skills/**/*.csv

# graphify: share only the queryable graph products (see graphify README, "Team setup")
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/manifest.json
